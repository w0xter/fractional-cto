---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import CapabilityTags from '../../components/CapabilityTags.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find(project => project.data.featured);
const others = projects.filter(project => project.id !== featured?.id);
---
<BaseLayout title="Trabajo · Luis Pozo" description="Proyectos, equipos y decisiones que han dado forma a mi trabajo como CTO." current="work"><main class="editorial-page"><section class="archive-hero"><div><a href="/" class="back-link">← Inicio</a><h1>El trabajo<br /><em>detrás del criterio.</em></h1></div><p>Productos, equipos y decisiones en contextos distintos. Una selección de experiencias que conectan las necesidades del negocio con el trabajo de ingeniería.</p></section>{featured && <section class="featured-project" aria-labelledby="featured-heading"><div class="featured-heading"><p class="section-label">Experiencia destacada</p><h2 id="featured-heading">{featured.data.title}</h2><p class="featured-subtitle">{featured.data.client} · plataforma educativa</p><CapabilityTags tags={featured.data.capabilities} /></div><div class="featured-content"><p class="featured-summary">{featured.data.summary}</p><p class="featured-role">{featured.data.role}</p><a class="editorial-link light-link" href={`/work/${featured.id}/`}>Explorar el caso <span aria-hidden="true">→</span></a></div><div class="featured-facts">{featured.data.facts?.map(fact => <p><strong>{fact.value}</strong><span>{fact.label}</span></p>)}</div></section>}<section class="archive-section"><div class="archive-heading"><h2>Otros contextos,<br /><em>otras decisiones.</em></h2><p>Una mirada a distintas etapas de producto, arquitectura y equipos.</p></div><div class="archive-list">{others.map(project => <ProjectRow project={project} />)}</div></section><section class="editorial-close"><h2>Las decisiones también cuentan la historia.</h2><a class="editorial-link" href="/decisions/">Explorar decisiones <span aria-hidden="true">→</span></a></section></main></BaseLayout>
